# ==========================================
# Horror Story Agent - Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# YouTube Data API v3 (Required for upload)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Upload privacy: private -> test first, then unlisted, then public
YOUTUBE_PRIVACY=private

# Ollama (Local LLM for story generation) - NOT used on GitHub Actions
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Story generation mode: ollama (local, unlimited) | gemini (free tier cloud, no cost)
# On CI use: gemini
STORY_API_MODE=ollama

# Gemini: free tier API key (NO CHARGES) - get yours at:
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Pollinations.ai - FREE, no API key needed
POLLINATIONS_BASE=https://image.pollinations.ai/prompt/

# Pexels / Pixabay for free horror background music (optional)
# Set FREE_BG_MUSIC_URI to a direct URL of an mp3 file
FREE_BG_MUSIC_URI=

# Channel / video settings
CHANNEL_NAME=Bhayanak Kahaniyan
STORY_LANGUAGE=hi
LANGUAGE_CODE=hi-IN
# edge-tts Hindi voices: hi-IN-MadhurNeural (male) / hi-IN-SwaraNeural (female)
VOICE_NAME=hi-IN-MadhurNeural
# Slower narration sounds creepier: VOICE_RATE=-10%
VOICE_RATE=+0%
VOICE_VOLUME=+0%

# Horizontal full video: H_FULL=1920 H_SHORT=1080
# Vertical shorts:    H_FULL=1080 H_SHORT=1920
VIDEO_ORIENTATION=vertical